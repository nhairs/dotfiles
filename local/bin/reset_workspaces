#!/bin/bash

## Functions
## -----------------------------------------------------------------------------
function move_workspaces {
    local SCREEN="$1"
    local WORKSPACES="$2"
    local CURRENT COMMAND RESPONSE

    if ! CURRENT=$(i3-msg -t get_workspaces) ||
       ! COMMAND=$(jq -r --arg screen "$SCREEN" --arg workspaces "$WORKSPACES" '
           ($workspaces | split(" ") | map(tonumber)) as $numbers
           | [sort_by(.num)[]
               | select(.output != $screen and (.num as $num | $numbers | index($num) != null))
               | if (.id | type) != "number" then error("Missing i3 workspace container ID")
                 else "[con_id=\(.id)] move workspace to output \($screen | @json)"
                 end]
           | join(";")
       ' <<< "$CURRENT"); then
        echo "Cannot read i3 workspaces for $SCREEN." >&2
        return 1
    fi
    [[ -n $COMMAND ]] || return 0

    if ! RESPONSE=$(i3-msg -t command "$COMMAND") ||
       ! jq -e 'type == "array" and length > 0 and all(.[]; .success == true)' <<< "$RESPONSE" >/dev/null; then
        printf 'Workspace moves to %s failed: %s\n%s\n' "$SCREEN" "$COMMAND" "$RESPONSE" >&2
        return 1
    fi
}

## Default Values
## -----------------------------------------------------------------------------

BIG_LEFT_WORKSPACES="2 4 6 8 10"
BIG_RIGHT_WORKSPACES="1 3 5 7 9 11 12 13 14 15 16 17 18 19"
SMALL_WORKSPACES="20"

BIG_LEFT_SCREEN="_big_left_missing_"
BIG_RIGHT_SCREEN="_big_right_missing_"
SMALL_SCREEN="eDP-1" # aka laptop screen

## Host Specific Values
## -----------------------------------------------------------------------------

if [ "$(hostname)" = "radon" ]; then
    BIG_LEFT_SCREEN=$(xrandr_to_edid | grep "DEL-39329-87GBP43" | cut -d ' ' -f 1)
    #BIG_LEFT_SCREEN=$(xrandr_to_edid | grep "DEL-39585-87GBP43" | cut -d ' ' -f 1)
    BIG_RIGHT_SCREEN=$(xrandr_to_edid | grep "DEL-26609-FB9YCH4" | cut -d ' ' -f 1)
    #BIG_RIGHT_SCREEN=$(xrandr_to_edid | grep "DEL-39585-JN0BP43" | cut -d ' ' -f 1)

elif [ "$(hostname)" = "neon" ]; then
    BIG_LEFT_SCREEN=$(xrandr_to_edid | grep "DEL-39329-87GBP43" | cut -d ' ' -f 1)
    #BIG_LEFT_SCREEN=$(xrandr_to_edid | grep "DEL-39585-87GBP43" | cut -d ' ' -f 1)
    BIG_RIGHT_SCREEN=$(xrandr_to_edid | grep "DEL-26609-FB9YCH4" | cut -d ' ' -f 1)
    #BIG_RIGHT_SCREEN=$(xrandr_to_edid | grep "DEL-39585-JN0BP43" | cut -d ' ' -f 1)
    SMALL_SCREEN="eDP"

elif [ "$(hostname)" = "nhairs-x1g8" ]; then
    ## Work
    if xrandr_to_edid | grep "SAM-41841-HNMW900360"; then
        BIG_LEFT_SCREEN=$(xrandr_to_edid | grep "VSC-13627-V5E201962534" | cut -d ' ' -f 1)
        BIG_RIGHT_SCREEN=$(xrandr_to_edid | grep "SAM-41841-HNMW900360" | cut -d ' ' -f 1)

    elif xrandr_to_edid | grep "DEL-39585-JN0BP43"; then
        ## Home
        BIG_LEFT_SCREEN=$(xrandr_to_edid | grep "DEL-39585-87GBP43" | cut -d ' ' -f 1)
        BIG_RIGHT_SCREEN=$(xrandr_to_edid | grep "DEL-39585-JN0BP43" | cut -d ' ' -f 1)
    else
        echo "unknown screens detected. exiting...."
        exit 1
    fi

else
    echo "unkown profile. exiting..."
    exit 1

fi

## Move workspaces to screens
## -----------------------------------------------------------------------------
#COMMAND=""

#for WORKSPACE in $BIG_LEFT_WORKSPACES; do
#    COMMAND="$COMMAND;[workspace=^${WORKSPACE}$] move workspace to output ${BIG_LEFT_SCREEN}"
#done


#for WORKSPACE in $SMALL_WORKSPACES; do
#    COMMAND="$COMMAND;[workspace=^${WORKSPACE}$] move workspace to output ${SMALL_SCREEN}"
#done


#for WORKSPACE in $BIG_RIGHT_WORKSPACES; do
#    COMMAND="$COMMAND;[workspace=^${WORKSPACE}$] move workspace to output ${BIG_RIGHT_SCREEN}"
#done

if [[ ! $BIG_LEFT_SCREEN =~ ^[[:alnum:]_.-]+$ || ! $BIG_RIGHT_SCREEN =~ ^[[:alnum:]_.-]+$ ||
      $BIG_LEFT_SCREEN == "$BIG_RIGHT_SCREEN" || $BIG_LEFT_SCREEN == "$SMALL_SCREEN" ||
      $BIG_RIGHT_SCREEN == "$SMALL_SCREEN" ]]; then
    echo 'Cannot reset workspaces without three distinct detected outputs.' >&2
    exit 1
fi

STATUS=0
move_workspaces "$BIG_LEFT_SCREEN" "$BIG_LEFT_WORKSPACES" || STATUS=1
move_workspaces "$BIG_RIGHT_SCREEN" "$BIG_RIGHT_WORKSPACES" || STATUS=1
move_workspaces "$SMALL_SCREEN" "$SMALL_WORKSPACES" || STATUS=1
exit "$STATUS"
